<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DraftLite</AssemblyName>
    <RootNamespace>DraftLite</RootNamespace>
    <Product>DraftLite</Product>
    <Company>Tastiere Digitali srls</Company>
    <Description>Scrittura di sceneggiature: la base di Final Draft, senza il resto.</Description>
    <!-- Versione ereditata da Directory.Build.props alla radice. -->

    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- permette dotnet build/publish anche da Linux o macOS (solo compilazione) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

</Project>
