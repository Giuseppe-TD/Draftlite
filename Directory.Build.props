<Project>
  <!-- Versione corrente/fallback per build locali. Quando pubblichi da GitHub Actions,
       il workflow aggiorna automaticamente questo valore e lo salva nel repository. -->
  <PropertyGroup>
    <Version>1.6.1</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
